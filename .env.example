# Dockore 环境变量示例
# 复制为 .env 后按需修改，docker compose 会自动读取同目录下的 .env
# cp .env.example .env

# 后端访问令牌（前端登录时输入；生产环境务必修改为强随机值）
DOCKORE_TOKEN=change-me

# 端口映射（宿主机端口）
DOCKORE_PORT=8000
DOCKORE_FRONTEND_PORT=8001
DOCKORE_PROXY_PORT=8002

# 允许的 CORS 来源，逗号分隔；默认 * 放行全部
# DOCKORE_CORS_ORIGINS=http://localhost:8001,http://127.0.0.1:8001
DOCKORE_CORS_ORIGINS=*

# 容器 daemon socket（挂载到容器内 /var/run/docker.sock）
# Podman 用户改为 podman socket 路径，如：
# DOCKORE_DOCKER_SOCK=/run/user/1000/podman/podman.sock
DOCKORE_DOCKER_SOCK=/var/run/docker.sock

# Stack 管理：stacks 目录，宿主机与容器内使用同一路径（保证 stack compose
# 文件内的相对 bind 路径可解析）。默认 /app/stacks，建议改为你的宿主机目录
DOCKORE_STACKS_DIR=/app/stacks
